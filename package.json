{
  "name": "simple-web2md-ext",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint src eslint.config.mjs webpack.config.js",
    "audit": "npm audit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run lint && npm run audit && npm run format",
    "build": "npm run package:chrome && npm run package:firefox",
    "prebuild:firefox": "npm run check",
    "build:firefox": "webpack --mode=production --env browser=firefox",
    "prebuild:chrome": "npm run check",
    "build:chrome": "webpack --mode=production --env browser=chrome",
    "package:firefox": "npm run build:firefox && shx mkdir -p release && cd dist/firefox && bestzip ../../release/simple-web2md-ext-firefox.zip *",
    "package:chrome": "npm run build:chrome && shx mkdir -p release && cd dist/chrome && bestzip ../../release/simple-web2md-ext-chrome.zip *"
  },
  "keywords": [],
  "author": {
    "name": "n622",
    "email": "n622jwith@gmail.com"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/turndown": "^5.0.6",
    "@types/webextension-polyfill": "^0.12.3",
    "bestzip": "^2.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "shx": "^0.3.4",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.100.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.0",
    "webextension-polyfill": "^0.12.0"
  }
}
