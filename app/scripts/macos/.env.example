# Copy to .env and chmod 600 .env. Values are literal; no shell evaluation.
# Required: replace this example with your SSH user and hostname/IP.
WEB2MD_MAC_HOST=build-user@mac.example
WEB2MD_TEAM_ID=GLQCJ8YF9S
WEB2MD_BUNDLE_ID=jp.co.kupac.web2md
WEB2MD_EXTENSION_ID=jp.co.kupac.web2md.SafariExtension
WEB2MD_APPSTORE_P12_PASSWORD=
WEB2MD_INSTALLER_P12_PASSWORD=
WEB2MD_GITHUB_P12_PASSWORD=
# Used only by the separate upload / notarize commands.
WEB2MD_API_KEY_ID=
WEB2MD_API_ISSUER_ID=
# Existing ref/macos/.env PRELIS_* credentials are also supported as a fallback.
